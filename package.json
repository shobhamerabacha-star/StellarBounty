{
  "name": "stellar-bounty",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/frontend",
    "apps/backend"
  ],
  "scripts": {
    "dev:frontend": "node init && npm run dev --workspace=apps/frontend",
    "dev:backend": "node init && npm run dev --workspace=apps/backend",
    "dev:up": "node init && docker compose up --build",
    "build": "node init && npm run build --workspaces --if-present",
    "install:all": "npm install",
    "release:check": "npm run build --workspaces --if-present && git diff --check",
    "version": "npm run release:check",
    "adr:new": "node scripts/adr-scaffold.js"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
